# ─── Database ───────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/venueiq?schema=public"

# ─── JWT ────────────────────────────────────────────
JWT_SECRET="venueiq-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="venueiq-refresh-secret-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Server ─────────────────────────────────────────
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# ─── Gemini AI ──────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
