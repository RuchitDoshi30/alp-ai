// Prisma Schema for VenueIQ Smart Stadium Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ──────────────────────────────────────

enum UserRole {
  attendee
  staff
  vendor
  admin
  super_admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         UserRole @default(attendee)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tickets      Ticket[]
  orders       Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─── Venue ─────────────────────────────────────────────

model Venue {
  id        String   @id @default(uuid())
  name      String
  city      String?
  capacity  Int
  lat       Float?
  lng       Float?
  mapSvgUrl String?  @map("map_svg_url")
  sportType String?  @map("sport_type")
  createdAt DateTime @default(now()) @map("created_at")

  events      Event[]
  crowdZones  CrowdZone[]
  gates       Gate[]
  foodVendors FoodVendor[]

  @@map("venues")
}

model CrowdZone {
  id        String   @id @default(uuid())
  venueId   String   @map("venue_id")
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  zoneName  String   @map("zone_name")
  density   Float    @default(0.0)
  riskLevel String   @default("normal") @map("risk_level")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crowd_zones")
}

model Gate {
  id         String @id @default(uuid())
  venueId    String @map("venue_id")
  venue      Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name       String
  direction  String
  congestion Float  @default(0.0)

  @@map("gates")
}

// ─── Events ────────────────────────────────────────────

enum EventStatus {
  scheduled
  live
  completed
  cancelled
}

model Event {
  id            String      @id @default(uuid())
  venueId       String      @map("venue_id")
  venue         Venue       @relation(fields: [venueId], references: [id])
  title         String
  sport         String
  homeTeamName  String      @map("home_team_name")
  homeTeamShort String      @map("home_team_short")
  homeTeamLogo  String?     @map("home_team_logo")
  awayTeamName  String      @map("away_team_name")
  awayTeamShort String      @map("away_team_short")
  awayTeamLogo  String?     @map("away_team_logo")
  homeScore     Int         @default(0) @map("home_score")
  awayScore     Int         @default(0) @map("away_score")
  period        String?
  status        EventStatus @default(scheduled)
  startTime     DateTime    @map("start_time")
  endTime       DateTime?   @map("end_time")
  createdAt     DateTime    @default(now()) @map("created_at")

  tickets      Ticket[]
  orders       Order[]
  alerts       Alert[]
  queueStatuses QueueStatus[]

  @@map("events")
}

// ─── Tickets ───────────────────────────────────────────

enum TicketStatus {
  valid
  scanned
  revoked
  expired
}

model Ticket {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id])
  eventId    String       @map("event_id")
  event      Event        @relation(fields: [eventId], references: [id])
  bookingRef String       @unique @map("booking_ref")
  section    String
  row        String?
  seat       String?
  gate       String?
  qrCode     String?      @unique @map("qr_code")
  status     TicketStatus @default(valid)
  scannedAt  DateTime?    @map("scanned_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("tickets")
}

// ─── Food & Orders ─────────────────────────────────────

model FoodVendor {
  id          String  @id @default(uuid())
  venueId     String  @map("venue_id")
  venue       Venue   @relation(fields: [venueId], references: [id])
  name        String
  location    String?
  cuisineType String? @map("cuisine_type")
  isActive    Boolean @default(true) @map("is_active")

  menuItems    MenuItem[]
  orders       Order[]
  queueStatuses QueueStatus[]

  @@map("food_vendors")
}

model MenuItem {
  id          String  @id @default(uuid())
  vendorId    String  @map("vendor_id")
  vendor      FoodVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal @db.Decimal(8, 2)
  category    String?
  imageUrl    String? @map("image_url")
  isAvailable Boolean @default(true) @map("is_available")

  orderItems  OrderItem[]

  @@map("menu_items")
}

enum OrderStatus {
  pending
  preparing
  ready
  delivered
  cancelled
}

model Order {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id])
  eventId      String      @map("event_id")
  event        Event       @relation(fields: [eventId], references: [id])
  vendorId     String      @map("vendor_id")
  vendor       FoodVendor  @relation(fields: [vendorId], references: [id])
  status       OrderStatus @default(pending)
  total        Decimal     @db.Decimal(10, 2)
  deliverySeat String?     @map("delivery_seat")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Decimal  @db.Decimal(8, 2)

  @@map("order_items")
}

// ─── Alerts & Queues ───────────────────────────────────

enum AlertType {
  emergency
  crowd
  weather
  info
}

enum AlertPriority {
  low
  normal
  high
  critical
}

model Alert {
  id        String        @id @default(uuid())
  eventId   String        @map("event_id")
  event     Event         @relation(fields: [eventId], references: [id])
  type      AlertType
  message   String
  priority  AlertPriority @default(normal)
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("alerts")
}

model QueueStatus {
  id          String     @id @default(uuid())
  vendorId    String     @map("vendor_id")
  vendor      FoodVendor @relation(fields: [vendorId], references: [id])
  eventId     String     @map("event_id")
  event       Event      @relation(fields: [eventId], references: [id])
  waitMinutes Int        @default(0) @map("wait_minutes")
  queueLength Int        @default(0) @map("queue_length")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("queue_status")
}
